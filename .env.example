# Copy to .env and adjust. Every setting is optional unless noted.

# --- MCP server ---
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Which city adapter to load (see src/adapters/registry.py).
CITY_ADAPTER=baltimore
LOG_LEVEL=INFO

# --- Redis cache (upstream API responses) ---
REDIS_URL=redis://cache:6379/0
# How long upstream responses are cached, in seconds.
CACHE_TTL_SECONDS=300

# --- Postgres (usage logs) ---
DATABASE_URL=postgresql://connector:connector@db:5432/civic_connector

# --- Baltimore open data + 311 (ArcGIS Hub) ---
# Open Baltimore (https://data.baltimorecity.gov) runs on ArcGIS Hub.
# Owner of the Hub catalog (used by list_open_datasets).
ARCGIS_HUB_OWNER=baltimore_city
# Feature Service URL for the 311 requests feed. Defaults to the current
# year's "311 Customer Service Requests" service. Find other years via
# list_open_datasets or https://bmore-open-data-baltimore.hub.arcgis.com.
ARCGIS_311_SERVICE_URL=https://services1.arcgis.com/UWYHeuuJISiGmgXx/arcgis/rest/services/311_Customer_Service_Requests_current/FeatureServer

# --- Socrata (for Socrata-powered cities) ---
# Portable client for cities whose open-data portal runs on Socrata
# (see docs/ADDING_A_CITY.md). Not used by the Baltimore adapter.
SOCRATA_DOMAIN=
# Optional: app token raises Socrata rate limits. Get one free from any
# Socrata portal -> Sign Up -> Developer Settings.
SOCRATA_APP_TOKEN=

# --- MTA transit (GTFS-RT) ---
# REQUIRED for the transit tool. URL of the MTA Maryland GTFS-RT Trip Updates
# feed. Get it from MTA's developer resources / transit data portal.
MTA_GTFS_RT_URL=

# --- Auth ---
# disabled  -> no auth (local dev default)
# apikey    -> check Authorization: Bearer <key> against API_KEYS
# supabase  -> validate Supabase JWTs against SUPABASE_JWKS_URL
AUTH_MODE=disabled
# Comma-separated list of static API keys (AUTH_MODE=apikey).
API_KEYS=
# Supabase Auth JWKS URL, e.g.
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
