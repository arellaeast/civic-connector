# Copy to .env and adjust. Every setting is optional unless noted.

# --- MCP server ---
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Which city adapter to load (see src/adapters/registry.py).
CITY_ADAPTER=baltimore
LOG_LEVEL=INFO

# --- Redis cache (upstream API responses) ---
REDIS_URL=redis://cache:6379/0
# How long upstream responses are cached, in seconds.
CACHE_TTL_SECONDS=300

# --- Postgres (usage logs) ---
DATABASE_URL=postgresql://connector:connector@db:5432/civic_connector

# --- Baltimore open data (Socrata) ---
# Domain of the city's Socrata open-data portal.
SOCRATA_DOMAIN=data.baltimorecity.gov
# Optional: app token raises Socrata rate limits. Get one free at
# https://data.baltimorecity.gov -> Sign Up -> Developer Settings.
SOCRATA_APP_TOKEN=

# --- Baltimore 311 ---
# REQUIRED for the 311 tools. The xxxx-xxxx dataset ID of the "311 Service
# Requests" dataset. Find it on Open Baltimore (https://data.baltimorecity.gov):
# open the dataset, click "API", and copy the ID from the API endpoint URL.
BALTIMORE_311_DATASET_ID=
# Column holding the service-request number. VERIFY against the dataset's
# column list (dataset page -> "View Data" -> column names) and adjust.
BALTIMORE_311_SR_COLUMN=srnumber

# --- MTA transit (GTFS-RT) ---
# REQUIRED for the transit tool. URL of the MTA Maryland GTFS-RT Trip Updates
# feed. Get it from MTA's developer resources / transit data portal.
MTA_GTFS_RT_URL=

# --- Auth ---
# disabled  -> no auth (local dev default)
# apikey    -> check Authorization: Bearer <key> against API_KEYS
# supabase  -> validate Supabase JWTs against SUPABASE_JWKS_URL
AUTH_MODE=disabled
# Comma-separated list of static API keys (AUTH_MODE=apikey).
API_KEYS=
# Supabase Auth JWKS URL, e.g.
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
